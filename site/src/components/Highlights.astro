---
import { HIGHLIGHTS } from "../data/site";
---

<section aria-label="Destaques" class="relative border-y border-[var(--color-border)]/60 bg-[var(--color-bg-elevated)]/40">
	<div class="max-w-6xl mx-auto px-6 py-10 md:py-12">
		<ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
			{
				HIGHLIGHTS.map((item) => (
					<li class="flex gap-3">
						<span class="mt-1.5 size-2 shrink-0 rounded-full bg-[var(--color-accent)]" aria-hidden="true" />
						<div>
							<h3 class="text-sm font-semibold text-[var(--color-fg)] mb-1">{item.title}</h3>
							<p class="text-sm text-[var(--color-fg-muted)] leading-relaxed">{item.body}</p>
						</div>
					</li>
				))
			}
		</ul>
	</div>
</section>
