---
import { USE_CASES } from "../data/site";
---

<section id="para-quem" class="relative py-20 md:py-28">
	<div class="max-w-6xl mx-auto px-6">
		<div class="max-w-2xl mb-12">
			<p class="text-sm font-mono text-[var(--color-accent)] uppercase tracking-wider mb-3">
				Para quem é
			</p>
			<h2 class="text-3xl md:text-4xl font-semibold tracking-tight mb-4">
				Feito para qualquer pessoa que usa um Mac
			</h2>
			<p class="text-lg text-[var(--color-fg-muted)] leading-relaxed">
				Se você troca de janela o tempo todo para abrir um app, fazer uma
				conta ou pesquisar alguma coisa, o Ptolemy encurta esse caminho para
				um atalho de teclado.
			</p>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
			{
				USE_CASES.map((useCase) => (
					<article class="p-6 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-bg-card)] hover:border-[var(--color-border-strong)] transition-colors">
						<h3 class="text-lg font-semibold text-[var(--color-fg)] mb-2">{useCase.title}</h3>
						<p class="text-sm text-[var(--color-fg-muted)] leading-relaxed mb-4">{useCase.body}</p>
						<ul class="flex flex-wrap gap-2">
							{useCase.examples.map((example) => (
								<li class="text-xs text-[var(--color-fg-muted)] px-2.5 py-1 rounded-full bg-[var(--color-accent-soft)] border border-[var(--color-accent)]/20">
									{example}
								</li>
							))}
						</ul>
					</article>
				))
			}
		</div>
	</div>
</section>
